{
    "functions": {
        "api/*.js": {
            "memory": 1024,
            "maxDuration": 10
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "env": {
        "SMTP_HOST": "@smtp_host",
        "SMTP_PORT": "@smtp_port",
        "SMTP_USER": "@smtp_user",
        "SMTP_PASS": "@smtp_pass",
        "SMTP_FROM": "@smtp_from",
        "SMTP_TO": "@smtp_to"
    }
}